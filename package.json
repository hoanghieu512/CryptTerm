{
  "name": "cryptterm",
  "version": "0.0.0",
  "private": true,
  "description": "Block-mode terminal that proves a signed settlement batch balances and respects policy limits, with a zero-knowledge proof generated in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:spike": "tsc --noEmit && vite build --mode spike",
    "check:spike-dist": "node scripts/check-spike-dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:circuit": "cd circuits/ledger_audit && nargo test",
    "build:circuit": "node scripts/build-circuit",
    "gen:samples": "node --import ./scripts/register-ts.mjs scripts/gen-samples.ts",
    "gen:identity": "node --import ./scripts/register-ts.mjs scripts/gen-circuit-identity.ts",
    "check:dist-vk": "node scripts/check-dist-vk",
    "test:proof": "vitest run --config vitest.proof.config.ts",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aztec-foundation/bb.js": "6.0.0",
    "@noir-lang/acvm_js": "1.0.0",
    "@noir-lang/noir_js": "1.0.0",
    "@noir-lang/noirc_abi": "1.0.0",
    "@noir-lang/types": "1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fast-check": "4.10.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
