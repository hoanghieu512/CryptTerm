{
  "name": "cryptterm",
  "version": "0.0.0",
  "private": true,
  "description": "Block-mode terminal that proves a signed settlement batch balances and respects policy limits, with a zero-knowledge proof generated in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:circuit": "cd circuits/ledger_audit && nargo test"
  },
  "dependencies": {
    "@aztec-foundation/bb.js": "6.0.0",
    "@noir-lang/acvm_js": "1.0.0",
    "@noir-lang/noir_js": "1.0.0",
    "@noir-lang/noirc_abi": "1.0.0",
    "@noir-lang/types": "1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fast-check": "4.10.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
